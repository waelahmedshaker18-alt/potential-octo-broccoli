# -*- coding: utf-8 -*-
"""
الحاسبة الذكية - Smart Invoice Calculator
نسخة أولية تعمل بواجهة Kivy.

الفكرة:
1) اختيار/التقاط صورة فاتورة.
2) في النسخة الحالية يمكن اختيار صورة من الجهاز.
3) استخراج الأرقام الظاهرة من الصورة بشكل تجريبي.
4) حساب مجموع الأرقام المستخرجة.
5) تجهيز مكان واضح لإضافة OCR حقيقي في الخطوة التالية.

ملاحظة:
قراءة النص من الصور OCR تحتاج محرك OCR مخصص عند تحويل التطبيق إلى Android.
هذه النسخة لا تدّعي أنها تقرأ كل الفاتورة بدقة قبل إضافة محرك OCR.
"""

import os
import re
from pathlib import Path

from kivy.app import App
from kivy.clock import Clock
from kivy.core.window import Window
from kivy.metrics import dp
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button
from kivy.uix.filechooser import FileChooserIconView
from kivy.uix.image import Image
from kivy.uix.label import Label
from kivy.uix.popup import Popup
from kivy.uix.scrollview import ScrollView
from kivy.uix.textinput import TextInput


Window.softinput_mode = "below_target"


ARABIC_DIGITS = str.maketrans(
    "٠١٢٣٤٥٦٧٨٩۰۱۲۳۴۵۶۷۸۹",
    "01234567890123456789"
)


def normalize_number_text(value: str) -> str:
    value = value.translate(ARABIC_DIGITS)
    value = value.replace("٫", ".").replace("٬", ",")
    return value


def extract_numbers(text: str):
    """
    استخراج الأرقام من نص OCR.
    يدعم:
    125
    125.50
    1,250.75
    ١٢٥٫٥٠
    """
    text = normalize_number_text(text)

    pattern = r"(?<![\w])\d+(?:[,.]\d+)*(?![\w])"
    raw = re.findall(pattern, text)

    numbers = []
    for item in raw:
        # لو الفاصلتان موجودتان، نفترض أن الفاصلة آلاف والنقطة عشرية
        if "," in item and "." in item:
            item = item.replace(",", "")
        elif "," in item:
            parts = item.split(",")
            # 1,250 -> آلاف
            if len(parts) == 2 and len(parts[1]) == 3:
                item = "".join(parts)
            else:
                item = ".".join(parts)

        try:
            numbers.append(float(item))
        except ValueError:
            pass

    return numbers


class InvoiceCalculator(BoxLayout):
    def __init__(self, **kwargs):
        super().__init__(
            orientation="vertical",
            spacing=dp(10),
            padding=dp(14),
            **kwargs
        )

        self.selected_image = None

        title = Label(
            text="الحاسبة الذكية",
            font_size=dp(28),
            size_hint_y=None,
            height=dp(55),
            bold=True,
        )
        self.add_widget(title)

        subtitle = Label(
            text="صوّر الفاتورة وسنجهز بياناتها للحساب",
            font_size=dp(16),
            size_hint_y=None,
            height=dp(40),
        )
        self.add_widget(subtitle)

        self.preview = Image(
            source="",
            allow_stretch=True,
            keep_ratio=True,
            size_hint_y=None,
            height=dp(230),
        )
        self.add_widget(self.preview)

        self.status = Label(
            text="لم يتم اختيار فاتورة",
            font_size=dp(16),
            size_hint_y=None,
            height=dp(45),
        )
        self.add_widget(self.status)

        buttons = BoxLayout(
            orientation="horizontal",
            spacing=dp(8),
            size_hint_y=None,
            height=dp(55),
        )

        choose_btn = Button(
            text="📷 اختيار صورة الفاتورة",
            font_size=dp(16),
        )
        choose_btn.bind(on_release=self.choose_image)
        buttons.add_widget(choose_btn)

        calculate_btn = Button(
            text="🧮 احسب",
            font_size=dp(16),
        )
        calculate_btn.bind(on_release=self.calculate)
        buttons.add_widget(calculate_btn)

        self.add_widget(buttons)

        self.result = TextInput(
            text="النتيجة ستظهر هنا...",
            readonly=True,
            multiline=True,
            font_size=dp(17),
            size_hint_y=1,
        )
        self.add_widget(self.result)

    def choose_image(self, *_):
        chooser = FileChooserIconView(
            filters=["*.png", "*.jpg", "*.jpeg", "*.webp"],
            path=str(Path.home()),
        )

        popup_layout = BoxLayout(
            orientation="vertical",
            spacing=dp(8),
            padding=dp(8),
        )

        popup_layout.add_widget(chooser)

        bottom = BoxLayout(
            size_hint_y=None,
            height=dp(50),
            spacing=dp(8),
        )

        cancel = Button(text="إلغاء")
        select = Button(text="اختيار")

        bottom.add_widget(cancel)
        bottom.add_widget(select)
        popup_layout.add_widget(bottom)

        popup = Popup(
            title="اختر صورة الفاتورة",
            content=popup_layout,
            size_hint=(0.95, 0.90),
        )

        cancel.bind(on_release=popup.dismiss)

        def select_image(_):
            if not chooser.selection:
                self.status.text = "اختر صورة أولاً"
                return

            self.selected_image = chooser.selection[0]
            self.preview.source = self.selected_image
            self.preview.reload()
            self.status.text = "تم اختيار صورة الفاتورة"
            popup.dismiss()

            self.result.text = (
                "تم تحميل صورة الفاتورة.\n\n"
                "الخطوة التالية هي تشغيل OCR الحقيقي لقراءة "
                "النص والأرقام من الصورة تلقائيًا."
            )

        select.bind(on_release=select_image)
        popup.open()

    def calculate(self, *_):
        if not self.selected_image:
            self.result.text = "من فضلك اختر صورة الفاتورة أولاً."
            return

        # هذه مرحلة مؤقتة لحين إضافة OCR الحقيقي.
        self.result.text = (
            "الصورة جاهزة للتحليل.\n\n"
            "⚠️ لم يتم تشغيل محرك OCR الحقيقي بعد.\n\n"
            "في المرحلة التالية سنضيف محرك قراءة الفاتورة، "
            "بحيث يقرأ الأصناف والكميات والأسعار والإجمالي "
            "من الصورة تلقائيًا ثم يعيد الحساب."
        )


class SmartInvoiceApp(App):
    title = "الحاسبة الذكية"

    def build(self):
        return InvoiceCalculator()


if __name__ == "__main__":
    SmartInvoiceApp().run()
