# -*- coding: utf-8 -*-
import sqlite3
import tkinter as tk
from tkinter import ttk, messagebox, filedialog
from datetime import datetime
import os
import platform
import tempfile
import shutil

# =========================================================
# WAEL SHAKER - STORE MANAGEMENT SYSTEM
# نظام إدارة المحل - وائل شاكر
# POS + BARCODE + USB SCANNER + 80mm RECEIPT
# INVENTORY + DISCOUNT + REPORTS + BACKUP
# =========================================================

DB_FILE = "store.db"
RECEIPT_WIDTH = 42

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
conn = sqlite3.connect(DB_FILE)
conn.row_factory = sqlite3.Row
conn.execute("PRAGMA foreign_keys = ON")
cur = conn.cursor()

cur.execute("""
CREATE TABLE IF NOT EXISTS products (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    barcode TEXT UNIQUE,
    name TEXT NOT NULL,
    cost REAL NOT NULL DEFAULT 0,
    price REAL NOT NULL DEFAULT 0,
    quantity INTEGER NOT NULL DEFAULT 0,
    min_quantity INTEGER NOT NULL DEFAULT 0,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
)
""")

cur.execute("""
CREATE TABLE IF NOT EXISTS sales (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    invoice_no TEXT UNIQUE,
    sale_date TEXT NOT NULL,
    subtotal REAL NOT NULL,
    discount REAL NOT NULL DEFAULT 0,
    total REAL NOT NULL,
    paid REAL NOT NULL,
    change_amount REAL NOT NULL,
    profit REAL NOT NULL DEFAULT 0
)
""")

cur.execute("""
CREATE TABLE IF NOT EXISTS sale_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sale_id INTEGER NOT NULL,
    product_id INTEGER NOT NULL,
    barcode TEXT,
    name TEXT NOT NULL,
    quantity INTEGER NOT NULL,
    price REAL NOT NULL,
    cost REAL NOT NULL,
    total REAL NOT NULL,
    FOREIGN KEY(sale_id) REFERENCES sales(id),
    FOREIGN KEY(product_id) REFERENCES products(id)
)
""")

cur.execute("""
CREATE TABLE IF NOT EXISTS settings (
    key TEXT PRIMARY KEY,
    value TEXT
)
""")

# Safe migration for databases created by older versions.
def add_column_if_missing(table, column, definition):
    cur.execute(f"PRAGMA table_info({table})")
    columns = [row["name"] for row in cur.fetchall()]
    if column not in columns:
        cur.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")

add_column_if_missing("products", "min_quantity", "INTEGER NOT NULL DEFAULT 0")
add_column_if_missing("products", "created_at", "TEXT")

add_column_if_missing("sales", "discount", "REAL NOT NULL DEFAULT 0")
add_column_if_missing("sales", "total", "REAL NOT NULL DEFAULT 0")

# Repair total for old invoices if necessary.
cur.execute("UPDATE sales SET total=subtotal WHERE total IS NULL OR total=0")
cur.execute("UPDATE products SET created_at=? WHERE created_at IS NULL OR created_at=''",
            (datetime.now().strftime("%Y-%m-%d %H:%M:%S"),))

conn.commit()


# ---------------------------------------------------------
# HELPERS
# ---------------------------------------------------------
def money(value):
    try:
        return f"{float(value):.2f}"
    except Exception:
        return "0.00"


def safe_float(value):
    try:
        text = str(value).strip().replace(",", ".")
        return float(text) if text else 0.0
    except Exception:
        return 0.0


def safe_int(value):
    try:
        return int(float(str(value).strip().replace(",", ".")))
    except Exception:
        return 0


def generate_invoice_no():
    return datetime.now().strftime("%Y%m%d%H%M%S%f")[:-3]


def clear_tree(tree):
    for item in tree.get_children():
        tree.delete(item)


def center_window(win, width, height):
    win.update_idletasks()
    sw = win.winfo_screenwidth()
    sh = win.winfo_screenheight()
    x = max(0, (sw - width) // 2)
    y = max(0, (sh - height) // 2)
    win.geometry(f"{width}x{height}+{x}+{y}")


def get_setting(key, default=""):
    cur.execute("SELECT value FROM settings WHERE key=?", (key,))
    row = cur.fetchone()
    return row["value"] if row else default


def set_setting(key, value):
    cur.execute("""
        INSERT INTO settings(key, value) VALUES(?, ?)
        ON CONFLICT(key) DO UPDATE SET value=excluded.value
    """, (key, str(value)))
    conn.commit()


def printer_name():
    return get_setting("printer_name", "")


def receipt_text(invoice_no, sale_date, items, subtotal, discount, total, paid,
                 change, profit=None):
    lines = []
    shop_name = get_setting("shop_name", "نظام إدارة المحل")
    owner_name = get_setting("owner_name", "وائل شاكر")
    phone = get_setting("shop_phone", "")

    lines.append(shop_name.center(RECEIPT_WIDTH))
    lines.append(owner_name.center(RECEIPT_WIDTH))
    if phone:
        lines.append(phone.center(RECEIPT_WIDTH))
    lines.append("-" * RECEIPT_WIDTH)
    lines.append(f"فاتورة: {invoice_no}")
    lines.append(f"التاريخ: {sale_date}")
    lines.append("-" * RECEIPT_WIDTH)

    for item in items:
        name = str(item["name"])[:24]
        lines.append(name)
        lines.append(
            f"{item['quantity']} x {money(item['price'])} = {money(item['total'])}"
        )

    lines.append("-" * RECEIPT_WIDTH)
    lines.append(f"الإجمالي قبل الخصم: {money(subtotal)}")
    lines.append(f"الخصم:              {money(discount)}")
    lines.append(f"الإجمالي:            {money(total)}")
    lines.append(f"المدفوع:             {money(paid)}")
    lines.append(f"الباقي:              {money(change)}")
    if profit is not None:
        lines.append(f"الربح:               {money(profit)}")
    lines.append("-" * RECEIPT_WIDTH)
    lines.append("شكرًا لزيارتكم".center(RECEIPT_WIDTH))
    return "\n".join(lines)


def print_text_receipt(text, parent=None):
    try:
        if platform.system() == "Windows":
            printer = printer_name()
            if printer:
                # Send raw text to the configured Windows printer.
                try:
                    import win32print
                    handle = win32print.OpenPrinter(printer)
                    try:
                        job = win32print.StartDocPrinter(handle, 1, ("Store Receipt", None, "RAW"))
                        try:
                            win32print.StartPagePrinter(handle)
                            data = ("\x1b\x40" + text + "\n\n\x1d\x56\x00").encode("cp1256", errors="replace")
                            win32print.WritePrinter(handle, data)
                            win32print.EndPagePrinter(handle)
                        finally:
                            win32print.EndDocPrinter(handle)
                    finally:
                        win32print.ClosePrinter(handle)
                    return True, "تم إرسال الفاتورة إلى الطابعة."
                except ImportError:
                    pass
                except Exception as e:
                    return False, str(e)

            fd, path = tempfile.mkstemp(suffix=".txt", text=True)
            os.close(fd)
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            os.startfile(path, "print")
            return True, "تم إرسال الفاتورة للطباعة."

        fd, path = tempfile.mkstemp(suffix=".txt", text=True)
        os.close(fd)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        return False, "تم تجهيز ملف الفاتورة. الطباعة المباشرة تحتاج إعداد الطابعة حسب نظام التشغيل."

    except Exception as e:
        return False, str(e)


