barcode_var = tk.StringVar()
name_var = tk.StringVar()
cost_var = tk.StringVar()
price_var = tk.StringVar()
qty_var = tk.StringVar()
min_qty_var = tk.StringVar(value="0")
search_var = tk.StringVar()

header = tk.Frame(root, bg="#1261a0", height=70)
header.pack(fill="x")
header.pack_propagate(False)

tk.Label(header,
         text="نظام إدارة المحل - وائل شاكر",
         bg="#1261a0", fg="white",
         font=("Arial", 22, "bold")).pack(expand=True)

product_frame = tk.LabelFrame(
    root, text="إدارة المنتجات",
    font=("Arial", 12, "bold"),
    bg="#eef2f5", padx=12, pady=10
)
product_frame.pack(fill="x", padx=12, pady=10)


def product_clear():
    barcode_var.set("")
    name_var.set("")
    cost_var.set("")
    price_var.set("")
    qty_var.set("")
    min_qty_var.set("0")
    product_tree.selection_remove(product_tree.selection())
    barcode_entry.focus_set()


def selected_product_id():
    selected = product_tree.selection()
    if not selected:
        return None
    try:
        return int(product_tree.item(selected[0], "values")[0])
    except Exception:
        return None


def load_product(event=None):
    selected = product_tree.selection()
    if not selected:
        return
    values = product_tree.item(selected[0], "values")
    barcode_var.set(values[1])
    name_var.set(values[2])
    cost_var.set(values[3])
    price_var.set(values[4])
    qty_var.set(values[5])
    min_qty_var.set(values[6])


def refresh_products(search=""):
    clear_tree(product_tree)
    text = search.strip()
    if text:
        cur.execute("""
            SELECT id, barcode, name, cost, price, quantity, min_quantity
            FROM products
            WHERE barcode LIKE ? OR name LIKE ?
            ORDER BY id DESC
        """, (f"%{text}%", f"%{text}%"))
    else:
        cur.execute("""
            SELECT id, barcode, name, cost, price, quantity, min_quantity
            FROM products ORDER BY id DESC
        """)
    for row in cur.fetchall():
        tag = "low" if row["quantity"] <= row["min_quantity"] else ""
        product_tree.insert("", "end", tags=(tag,), values=(
            row["id"],
            row["barcode"] or "",
            row["name"],
            money(row["cost"]),
            money(row["price"]),
            row["quantity"],
            row["min_quantity"]
        ))


def add_product():
    barcode = barcode_var.get().strip()
    name = name_var.get().strip()
    cost = safe_float(cost_var.get())
    price = safe_float(price_var.get())
    qty = safe_int(qty_var.get())
    min_qty = safe_int(min_qty_var.get())

    if not name:
        messagebox.showwarning("تنبيه", "اكتب اسم المنتج.")
        name_entry.focus_set()
        return
    if cost < 0 or price < 0 or qty < 0 or min_qty < 0:
        messagebox.showwarning("تنبيه", "القيم لا يمكن أن تكون سالبة.")
        return

    try:
        cur.execute("""
            INSERT INTO products
            (barcode, name, cost, price, quantity, min_quantity, created_at)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (barcode or None, name, cost, price, qty, min_qty,
              datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
        conn.commit()
        refresh_products(search_var.get())
        product_clear()
        messagebox.showinfo("نجاح", "تمت إضافة المنتج بنجاح.")
    except sqlite3.IntegrityError:
        messagebox.showerror("خطأ", "رقم الباركود مستخدم بالفعل.")
    except Exception as e:
        messagebox.showerror("خطأ", str(e))


def update_product():
    pid = selected_product_id()
    if pid is None:
        messagebox.showwarning("تنبيه", "اختر منتجًا من الجدول أولًا.")
        return

    barcode = barcode_var.get().strip()
    name = name_var.get().strip()
    cost = safe_float(cost_var.get())
    price = safe_float(price_var.get())
    qty = safe_int(qty_var.get())
    min_qty = safe_int(min_qty_var.get())

    if not name:
        messagebox.showwarning("تنبيه", "اكتب اسم المنتج.")
        return
    if cost < 0 or price < 0 or qty < 0 or min_qty < 0:
        messagebox.showwarning("تنبيه", "القيم لا يمكن أن تكون سالبة.")
        return

    try:
        cur.execute("""
            UPDATE products
            SET barcode=?, name=?, cost=?, price=?, quantity=?, min_quantity=?
            WHERE id=?
        """, (barcode or None, name, cost, price, qty, min_qty, pid))
        conn.commit()
        refresh_products(search_var.get())
        product_clear()
        messagebox.showinfo("نجاح", "تم تعديل المنتج بنجاح.")
    except sqlite3.IntegrityError:
        messagebox.showerror("خطأ", "رقم الباركود مستخدم لمنتج آخر.")
    except Exception as e:
        messagebox.showerror("خطأ", str(e))


def delete_product():
    pid = selected_product_id()
    if pid is None:
        messagebox.showwarning("تنبيه", "اختر منتجًا من الجدول أولًا.")
        return

    if not messagebox.askyesno("تأكيد", "هل تريد حذف المنتج؟"):
        return

    cur.execute("SELECT COUNT(*) AS c FROM sale_items WHERE product_id=?", (pid,))
    if cur.fetchone()["c"]:
        messagebox.showwarning(
            "تنبيه",
            "لا يمكن حذف منتج تم استخدامه في فواتير سابقة.\n"
            "يمكنك تعديل بياناته بدلًا من حذفه."
        )
        return

    cur.execute("DELETE FROM products WHERE id=?", (pid,))
    conn.commit()
    refresh_products(search_var.get())
    product_clear()
    messagebox.showinfo("نجاح", "تم حذف المنتج.")


