# ---------------------------------------------------------
# POS
# ---------------------------------------------------------
def open_pos():
    pos = tk.Toplevel(root)
    pos.title("نقطة البيع - نظام إدارة المحل")
    pos.geometry("1120x720")
    pos.minsize(950, 620)
    pos.configure(bg="#f2f4f7")
    center_window(pos, 1120, 720)

    cart = []
    scan_var = tk.StringVar()
    paid_var = tk.StringVar()
    discount_var = tk.StringVar(value="0")
    total_var = tk.StringVar(value="0.00")
    subtotal_var = tk.StringVar(value="0.00")
    change_var = tk.StringVar(value="0.00")

    top = tk.Frame(pos, bg="#1261a0", height=60)
    top.pack(fill="x")
    top.pack_propagate(False)
    tk.Label(top, text="نقطة البيع POS",
             bg="#1261a0", fg="white",
             font=("Arial", 20, "bold")).pack(expand=True)

    input_frame = tk.LabelFrame(
        pos, text="إضافة المنتجات",
        bg="#f2f4f7", font=("Arial", 11, "bold"),
        padx=10, pady=8
    )
    input_frame.pack(fill="x", padx=10, pady=10)

    tk.Label(input_frame, text="الباركود / اسم المنتج:",
             bg="#f2f4f7", font=("Arial", 10, "bold")).pack(side="right", padx=5)

    scan_entry = tk.Entry(input_frame, textvariable=scan_var,
                          font=("Arial", 14), justify="right", width=35)
    scan_entry.pack(side="right", padx=5)

    def find_product(value):
        value = value.strip()
        if not value:
            return None
        cur.execute("""
            SELECT * FROM products
            WHERE barcode=? OR name=?
            LIMIT 1
        """, (value, value))
        row = cur.fetchone()
        if row is None:
            cur.execute("""
                SELECT * FROM products
                WHERE barcode LIKE ? OR name LIKE ?
                ORDER BY name LIMIT 1
            """, (f"%{value}%", f"%{value}%"))
            row = cur.fetchone()
        return row

    def recalc():
        subtotal = sum(x["total"] for x in cart)
        discount = max(0.0, safe_float(discount_var.get()))
        if discount > subtotal:
            discount = subtotal
            discount_var.set(money(discount))
        total = max(0.0, subtotal - discount)
        paid = safe_float(paid_var.get())
        change = max(0.0, paid - total)
        subtotal_var.set(money(subtotal))
        total_var.set(money(total))
        change_var.set(money(change))

    def refresh_cart():
        clear_tree(cart_tree)
        for i, item in enumerate(cart):
            cart_tree.insert("", "end", values=(
                i + 1, item["barcode"], item["name"],
                item["quantity"], money(item["price"]), money(item["total"])
            ))
        recalc()

    def add_to_cart():
        value = scan_var.get().strip()
        if not value:
            return

        product = find_product(value)
        if product is None:
            messagebox.showerror("غير موجود", "لم يتم العثور على المنتج.",
                                 parent=pos)
            scan_entry.selection_range(0, "end")
            return

        if product["quantity"] <= 0:
            messagebox.showwarning("المخزون", "هذا المنتج غير متوفر في المخزون.",
                                   parent=pos)
            return

        existing = next((x for x in cart if x["id"] == product["id"]), None)
        current_qty = existing["quantity"] if existing else 0

        if current_qty + 1 > product["quantity"]:
            messagebox.showwarning(
                "المخزون",
                f"الكمية المتاحة من المنتج: {product['quantity']}",
                parent=pos
            )
            return

        if existing:
            existing["quantity"] += 1
            existing["total"] = existing["quantity"] * existing["price"]
        else:
            cart.append({
                "id": product["id"],
                "barcode": product["barcode"] or "",
                "name": product["name"],
                "quantity": 1,
                "price": float(product["price"]),
                "cost": float(product["cost"]),
                "total": float(product["price"])
            })

        scan_var.set("")
        refresh_cart()
        scan_entry.focus_set()

    def remove_cart_item():
        selected = cart_tree.selection()
        if not selected:
            return
        idx = cart_tree.index(selected[0])
        if 0 <= idx < len(cart):
            cart.pop(idx)
            refresh_cart()

    def clear_cart():
        if cart and not messagebox.askyesno(
            "تأكيد", "هل تريد مسح الفاتورة الحالية؟", parent=pos
        ):
            return
        cart.clear()
        paid_var.set("")
        discount_var.set("0")
        refresh_cart()
        scan_entry.focus_set()

    def change_quantity():
        selected = cart_tree.selection()
        if not selected:
            messagebox.showwarning("تنبيه", "اختر صنفًا من الفاتورة.", parent=pos)
            return

        idx = cart_tree.index(selected[0])
        item = cart[idx]

        win = tk.Toplevel(pos)
        win.title("تعديل الكمية")
        win.geometry("300x160")
        win.transient(pos)
        win.grab_set()
        center_window(win, 300, 160)

        tk.Label(win, text="الكمية الجديدة:",
                 font=("Arial", 11, "bold")).pack(pady=10)
        qv = tk.StringVar(value=str(item["quantity"]))
        qe = tk.Entry(win, textvariable=qv,
                      font=("Arial", 13), justify="center")
        qe.pack()
        qe.focus_set()

        def save():
            q = safe_int(qv.get())
            cur.execute("SELECT quantity FROM products WHERE id=?", (item["id"],))
            row = cur.fetchone()
            available = row["quantity"] if row else 0
            if q <= 0:
                messagebox.showwarning("تنبيه", "الكمية يجب أن تكون أكبر من صفر.",
                                       parent=win)
                return
            if q > available:
                messagebox.showwarning("المخزون", f"المتاح: {available}",
                                       parent=win)
                return
            item["quantity"] = q
            item["total"] = q * item["price"]
            refresh_cart()
            win.destroy()

        tk.Button(win, text="حفظ", command=save,
                  bg="#2e8b57", fg="white",
                  font=("Arial", 10, "bold"),
                  width=12).pack(pady=10)

        qe.bind("<Return>", lambda e: save())

    def product_search_window():
        win = tk.Toplevel(pos)
        win.title("بحث عن منتج")
        win.geometry("750x500")
        center_window(win, 750, 500)
        win.transient(pos)

        sv = tk.StringVar()
        topf = tk.Frame(win)
        topf.pack(fill="x", padx=10, pady=10)
        ent = tk.Entry(topf, textvariable=sv,
                       font=("Arial", 13), justify="right")
        ent.pack(side="right", fill="x", expand=True, padx=5)

        cols = ("id", "barcode", "name", "price", "quantity")
        tr = ttk.Treeview(win, columns=cols, show="headings")
        hs = {"id": "الرقم", "barcode": "الباركود", "name": "المنتج",
              "price": "السعر", "quantity": "المخزون"}
        for c in cols:
            tr.heading(c, text=hs[c])
            tr.column(c, anchor="center")
        tr.pack(fill="both", expand=True, padx=10, pady=5)

        def load():
            clear_tree(tr)
            text = sv.get().strip()
            cur.execute("""
                SELECT id, barcode, name, price, quantity
                FROM products
                WHERE barcode LIKE ? OR name LIKE ?
                ORDER BY name
            """, (f"%{text}%", f"%{text}%"))
            for row in cur.fetchall():
                tr.insert("", "end", values=(
                    row["id"], row["barcode"] or "", row["name"],
                    money(row["price"]), row["quantity"]
                ))

        def choose():
            sel = tr.selection()
            if not sel:
                return
            values = tr.item(sel[0], "values")
            scan_var.set(values[1] or values[2])
            win.destroy()
            add_to_cart()

        tk.Button(topf, text="بحث", command=load,
                  bg="#2878c8", fg="white",
                  font=("Arial", 10, "bold")).pack(side="right")
        tk.Button(win, text="إضافة المحدد", command=choose,
                  bg="#2e8b57", fg="white",
                  font=("Arial", 10, "bold")).pack(pady=8)

        ent.bind("<KeyRelease>", lambda e: load())
        tr.bind("<Double-1>", lambda e: choose())
        load()
        ent.focus_set()

    def complete_sale():
        if not cart:
            messagebox.showwarning("تنبيه", "الفاتورة فارغة.", parent=pos)
            return

        subtotal = sum(x["total"] for x in cart)
        discount = max(0.0, safe_float(discount_var.get()))
        discount = min(discount, subtotal)
        total = subtotal - discount
        paid = safe_float(paid_var.get())

        if paid < total:
            messagebox.showwarning(
                "المبلغ المدفوع",
                "المبلغ المدفوع أقل من إجمالي الفاتورة.",
                parent=pos
            )
            paid_entry.focus_set()
            return

        # Re-check stock immediately before transaction.
        for item in cart:
            cur.execute("""
                SELECT quantity, cost, price, name, barcode
                FROM products WHERE id=?
            """, (item["id"],))
            row = cur.fetchone()
            if row is None:
                messagebox.showerror("خطأ",
                                     f"المنتج غير موجود: {item['name']}",
                                     parent=pos)
                return
            if item["quantity"] > row["quantity"]:
                messagebox.showerror(
                    "المخزون",
                    f"المخزون غير كافٍ للمنتج: {item['name']}\n"
                    f"المتاح: {row['quantity']}",
                    parent=pos
                )
                return

        invoice_no = generate_invoice_no()
        sale_date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        change = paid - total
        profit_before_discount = sum(
            (item["price"] - item["cost"]) * item["quantity"]
            for item in cart
        )
        profit = profit_before_discount - discount

        try:
            conn.execute("BEGIN")

            cur.execute("""
                INSERT INTO sales
                (invoice_no, sale_date, subtotal, discount, total,
                 paid, change_amount, profit)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """, (invoice_no, sale_date, subtotal, discount, total,
                  paid, change, profit))

            sale_id = cur.lastrowid

            for item in cart:
                cur.execute("""
                    INSERT INTO sale_items
                    (sale_id, product_id, barcode, name,
                     quantity, price, cost, total)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    sale_id, item["id"], item["barcode"], item["name"],
                    item["quantity"], item["price"], item["cost"], item["total"]
                ))
                cur.execute("""
                    UPDATE products
                    SET quantity = quantity - ?
                    WHERE id=? AND quantity >= ?
                """, (item["quantity"], item["id"], item["quantity"]))
                if cur.rowcount != 1:
                    raise RuntimeError("تعذر تحديث مخزون أحد المنتجات.")

            conn.commit()

            saved_items = [dict(x) for x in cart]
            cart.clear()
            paid_var.set("")
            discount_var.set("0")
            refresh_cart()
            refresh_products(search_var.get())

            messagebox.showinfo(
                "تمت عملية البيع",
                f"تم حفظ الفاتورة بنجاح.\n"
                f"رقم الفاتورة: {invoice_no}\n"
                f"الإجمالي: {money(total)}\n"
                f"الباقي: {money(change)}",
                parent=pos
            )

            show_receipt_preview(
                pos, invoice_no, sale_date, saved_items,
                subtotal, discount, total, paid, change, profit
            )
            scan_entry.focus_set()

        except Exception as e:
            conn.rollback()
            messagebox.showerror("خطأ", str(e), parent=pos)

    # Buttons/input
    tk.Button(input_frame, text="إضافة",
              command=add_to_cart,
              bg="#2e8b57", fg="white",
              font=("Arial", 10, "bold"), width=12).pack(side="right", padx=5)

    tk.Button(input_frame, text="بحث عن منتج",
              command=product_search_window,
              bg="#2878c8", fg="white",
              font=("Arial", 10, "bold"), width=13).pack(side="right", padx=5)

    tk.Label(input_frame,
             text="قارئ USB: امسح الباركود ثم Enter",
             bg="#f2f4f7", fg="#555",
             font=("Arial", 9)).pack(side="left", padx=10)

    cart_frame = tk.Frame(pos)
    cart_frame.pack(fill="both", expand=True, padx=10, pady=5)

    cart_columns = ("num", "barcode", "name", "qty", "price", "total")
    cart_tree = ttk.Treeview(cart_frame, columns=cart_columns,
                             show="headings", selectmode="browse")

    cart_headers = {
        "num": "م", "barcode": "الباركود", "name": "اسم المنتج",
        "qty": "الكمية", "price": "سعر البيع", "total": "الإجمالي"
    }
    cart_widths = {
        "num": 50, "barcode": 170, "name": 320,
        "qty": 90, "price": 120, "total": 130
    }
    for col in cart_columns:
        cart_tree.heading(col, text=cart_headers[col])
        cart_tree.column(col, width=cart_widths[col], anchor="center")

    cart_scroll = ttk.Scrollbar(cart_frame, orient="vertical",
                                command=cart_tree.yview)
    cart_tree.configure(yscrollcommand=cart_scroll.set)
    cart_tree.pack(side="left", fill="both", expand=True)
    cart_scroll.pack(side="right", fill="y")

    action_frame = tk.Frame(pos, bg="#f2f4f7")
    action_frame.pack(fill="x", padx=10, pady=8)

    tk.Button(action_frame, text="تعديل الكمية",
              command=change_quantity, bg="#e69b2f", fg="white",
              font=("Arial", 10, "bold"), width=13).pack(side="right", padx=4)
    tk.Button(action_frame, text="حذف الصنف",
              command=remove_cart_item, bg="#d9534f", fg="white",
              font=("Arial", 10, "bold"), width=13).pack(side="right", padx=4)
    tk.Button(action_frame, text="مسح الفاتورة",
              command=clear_cart, bg="#666", fg="white",
              font=("Arial", 10, "bold"), width=13).pack(side="right", padx=4)

    totals = tk.Frame(pos, bg="white", bd=1, relief="solid")
    totals.pack(fill="x", padx=10, pady=5)

    tk.Label(totals, text="قبل الخصم:", bg="white",
             font=("Arial", 12, "bold")).grid(row=0, column=7, padx=7, pady=8)
    tk.Label(totals, textvariable=subtotal_var, bg="white",
             fg="#1261a0", font=("Arial", 14, "bold")).grid(row=0, column=6)

    tk.Label(totals, text="الخصم:", bg="white",
             font=("Arial", 12, "bold")).grid(row=0, column=5, padx=7)
    discount_entry = tk.Entry(totals, textvariable=discount_var,
                              font=("Arial", 13, "bold"),
                              justify="center", width=10)
    discount_entry.grid(row=0, column=4, padx=7)

    tk.Label(totals, text="الإجمالي:", bg="white",
             font=("Arial", 12, "bold")).grid(row=0, column=3, padx=7)
    tk.Label(totals, textvariable=total_var, bg="white",
             fg="#1261a0", font=("Arial", 16, "bold")).grid(row=0, column=2)

    tk.Label(totals, text="المدفوع:", bg="white",
             font=("Arial", 12, "bold")).grid(row=0, column=1, padx=7)
    paid_entry = tk.Entry(totals, textvariable=paid_var,
                          font=("Arial", 14, "bold"),
                          justify="center", width=12)
    paid_entry.grid(row=0, column=0, padx=7)

    change_frame = tk.Frame(pos, bg="#eaf7ee", bd=1, relief="solid")
    change_frame.pack(fill="x", padx=10, pady=4)
    tk.Label(change_frame, text="الباقي:", bg="#eaf7ee",
             font=("Arial", 13, "bold")).pack(side="right", padx=10)
    tk.Label(change_frame, textvariable=change_var, bg="#eaf7ee",
             fg="#2e8b57", font=("Arial", 17, "bold")).pack(side="right")

    bottom = tk.Frame(pos, bg="#f2f4f7")
    bottom.pack(fill="x", padx=10, pady=8)

    tk.Button(bottom, text="إتمام البيع",
              command=complete_sale, bg="#1261a0", fg="white",
              font=("Arial", 13, "bold"), width=18).pack(side="right", padx=8)
    tk.Button(bottom, text="إغلاق", command=pos.destroy,
              bg="#555", fg="white",
              font=("Arial", 11, "bold"), width=12).pack(side="left", padx=8)

    scan_entry.bind("<Return>", lambda e: add_to_cart())
    paid_entry.bind("<KeyRelease>", lambda e: recalc())
    discount_entry.bind("<KeyRelease>", lambda e: recalc())
    scan_entry.focus_set()


# ---------------------------------------------------------
# RECEIPT PREVIEW
# ---------------------------------------------------------
def show_receipt_preview(parent, invoice_no, sale_date, items, subtotal,
                         discount, total, paid, change, profit):
    text = receipt_text(
        invoice_no, sale_date, items,
        subtotal, discount, total, paid, change, profit
    )

    preview = tk.Toplevel(parent)
    preview.title("معاينة الفاتورة")
    preview.geometry("500x650")
    center_window(preview, 500, 650)

    txt = tk.Text(preview, font=("Courier New", 11),
                  wrap="none", padx=15, pady=15)
    txt.pack(fill="both", expand=True)
    txt.insert("1.0", text)
    txt.configure(state="disabled")

    def save_receipt():
        filename = filedialog.asksaveasfilename(
            parent=preview,
            title="حفظ الفاتورة",
            initialfile=f"فاتورة_{invoice_no}.txt",
            defaultextension=".txt",
            filetypes=[("Text files", "*.txt")]
        )
        if not filename:
            return
        try:
            with open(filename, "w", encoding="utf-8") as f:
                f.write(text)
            messagebox.showinfo("تم الحفظ", "تم حفظ الفاتورة بنجاح.",
                                parent=preview)
        except Exception as e:
            messagebox.showerror("خطأ", str(e), parent=preview)

    def do_print():
        ok, msg = print_text_receipt(text, preview)
        if ok:
            messagebox.showinfo("الطباعة", msg, parent=preview)
        else:
            messagebox.showwarning("الطباعة", msg, parent=preview)

    btns = tk.Frame(preview)
    btns.pack(fill="x", pady=8)
    tk.Button(btns, text="حفظ", command=save_receipt,
              bg="#2878c8", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=8)
    tk.Button(btns, text="طباعة 80mm", command=do_print,
              bg="#2e8b57", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=8)
    tk.Button(btns, text="إغلاق", command=preview.destroy,
              bg="#666", fg="white",
              font=("Arial", 10, "bold")).pack(side="left", padx=8)


# ---------------------------------------------------------
# INVENTORY REPORT
# ---------------------------------------------------------
def open_inventory():
    win = tk.Toplevel(root)
    win.title("المخزون والمنتجات الناقصة")
    win.geometry("950x620")
    center_window(win, 950, 620)
    win.configure(bg="#f2f4f7")

    tk.Label(win, text="المخزون",
             bg="#1261a0", fg="white",
             font=("Arial", 20, "bold")).pack(fill="x", ipady=15)

    search = tk.StringVar()
    topf = tk.Frame(win, bg="#f2f4f7")
    topf.pack(fill="x", padx=12, pady=10)

    tk.Label(topf, text="بحث:", bg="#f2f4f7",
             font=("Arial", 10, "bold")).pack(side="right")
    ent = tk.Entry(topf, textvariable=search,
                   font=("Arial", 11), justify="right", width=35)
    ent.pack(side="right", padx=6)

    only_low = tk.BooleanVar(value=False)
    tk.Checkbutton(topf, text="المنتجات الناقصة فقط",
                   variable=only_low, bg="#f2f4f7",
                   font=("Arial", 10, "bold")).pack(side="right", padx=10)

    cols = ("id", "barcode", "name", "cost", "price", "qty", "min", "value")
    tr = ttk.Treeview(win, columns=cols, show="headings")
    hs = {
        "id": "الرقم", "barcode": "الباركود", "name": "المنتج",
        "cost": "التكلفة", "price": "البيع", "qty": "المخزون",
        "min": "الحد الأدنى", "value": "قيمة المخزون"
    }
    for c in cols:
        tr.heading(c, text=hs[c])
        tr.column(c, anchor="center")
    tr.pack(fill="both", expand=True, padx=12, pady=5)

    def load():
        clear_tree(tr)
        text = search.get().strip()
        query = """
            SELECT id, barcode, name, cost, price, quantity, min_quantity
            FROM products
            WHERE (barcode LIKE ? OR name LIKE ?)
        """
        params = [f"%{text}%", f"%{text}%"]
        if only_low.get():
            query += " AND quantity <= min_quantity "
        query += " ORDER BY quantity ASC, name ASC"
        cur.execute(query, params)
        for row in cur.fetchall():
            tr.insert("", "end", values=(
                row["id"], row["barcode"] or "", row["name"],
                money(row["cost"]), money(row["price"]),
                row["quantity"], row["min_quantity"],
                money(row["cost"] * row["quantity"])
            ))

    tk.Button(topf, text="تحديث", command=load,
              bg="#2878c8", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=5)
    ent.bind("<KeyRelease>", lambda e: load())
    only_low.trace_add("write", lambda *args: load())
    load()


# ---------------------------------------------------------
# REPORTS
# ---------------------------------------------------------
def open_reports():
    win = tk.Toplevel(root)
    win.title("التقارير والأرباح")
    win.geometry("1100x700")
    win.minsize(900, 600)
    center_window(win, 1100, 700)
    win.configure(bg="#f2f4f7")

    tk.Label(win, text="التقارير والأرباح",
             bg="#1261a0", fg="white",
             font=("Arial", 20, "bold")).pack(fill="x", ipady=15)

    stats = tk.Frame(win, bg="#f2f4f7")
    stats.pack(fill="x", padx=15, pady=12)

    today = datetime.now().strftime("%Y-%m-%d")
    month = datetime.now().strftime("%Y-%m")

    def get_stats(pattern):
        cur.execute("""
            SELECT COALESCE(SUM(total),0),
                   COALESCE(SUM(profit),0),
                   COUNT(*),
                   COALESCE(SUM(discount),0)
            FROM sales WHERE sale_date LIKE ?
        """, (pattern,))
        return cur.fetchone()

    d = get_stats(f"{today}%")
    m = get_stats(f"{month}%")

    cards = [
        ("مبيعات اليوم", money(d[0])),
        ("أرباح اليوم", money(d[1])),
        ("فواتير اليوم", str(d[2])),
        ("خصومات اليوم", money(d[3])),
        ("مبيعات الشهر", money(m[0])),
        ("أرباح الشهر", money(m[1])),
    ]

    for i, (title, value) in enumerate(cards):
        card = tk.Frame(stats, bg="white", bd=1, relief="solid")
        card.grid(row=0, column=i, padx=5, sticky="nsew")
        tk.Label(card, text=title, bg="white",
                 font=("Arial", 10, "bold")).pack(pady=(10, 4))
        tk.Label(card, text=value, bg="white", fg="#1261a0",
                 font=("Arial", 14, "bold")).pack(pady=(0, 10))
        stats.grid_columnconfigure(i, weight=1)

    filter_frame = tk.Frame(win, bg="#f2f4f7")
    filter_frame.pack(fill="x", padx=15, pady=5)

    cols = ("id", "invoice", "date", "subtotal", "discount",
            "total", "paid", "change", "profit")
    tree = ttk.Treeview(filter_frame, columns=cols,
                        show="headings", height=15)

    hs = {
        "id": "الرقم", "invoice": "رقم الفاتورة", "date": "التاريخ",
        "subtotal": "قبل الخصم", "discount": "الخصم", "total": "الإجمالي",
        "paid": "المدفوع", "change": "الباقي", "profit": "الربح"
    }
    for c in cols:
        tree.heading(c, text=hs[c])
        tree.column(c, width=105, anchor="center")
    tree.pack(side="left", fill="both", expand=True)

    scr = ttk.Scrollbar(filter_frame, orient="vertical", command=tree.yview)
    tree.configure(yscrollcommand=scr.set)
    scr.pack(side="right", fill="y")

    def load_sales(period="today"):
        clear_tree(tree)
        if period == "today":
            pattern = f"{today}%"
        elif period == "month":
            pattern = f"{month}%"
        else:
            pattern = "%"
        cur.execute("""
            SELECT id, invoice_no, sale_date, subtotal, discount,
                   total, paid, change_amount, profit
            FROM sales
            WHERE sale_date LIKE ?
            ORDER BY id DESC
        """, (pattern,))
        for row in cur.fetchall():
            tree.insert("", "end", values=(
                row["id"], row["invoice_no"], row["sale_date"],
                money(row["subtotal"]), money(row["discount"]),
                money(row["total"]), money(row["paid"]),
                money(row["change_amount"]), money(row["profit"])
            ))

    buttons = tk.Frame(win, bg="#f2f4f7")
    buttons.pack(fill="x", padx=15, pady=10)

    tk.Button(buttons, text="مبيعات اليوم",
              command=lambda: load_sales("today"),
              bg="#2878c8", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=5)
    tk.Button(buttons, text="مبيعات الشهر",
              command=lambda: load_sales("month"),
              bg="#7b61a8", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=5)
    tk.Button(buttons, text="كل الفواتير",
              command=lambda: load_sales("all"),
              bg="#555f69", fg="white",
              font=("Arial", 10, "bold")).pack(side="right", padx=5)

    def show_invoice():
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("تنبيه", "اختر فاتورة أولًا.", parent=win)
            return

        sale_id = tree.item(selected[0], "values")[0]
        cur.execute("SELECT * FROM sales WHERE id=?", (sale_id,))
        sale = cur.fetchone()
        cur.execute("""
            SELECT * FROM sale_items
            WHERE sale_id=? ORDER BY id
        """, (sale_id,))
        items = cur.fetchall()

        text = receipt_text(
            sale["invoice_no"], sale["sale_date"],
            [dict(x) for x in items],
            sale["subtotal"], sale["discount"], sale["total"],
            sale["paid"], sale["change_amount"], sale["profit"]
        )

        detail = tk.Toplevel(win)
        detail.title("تفاصيل الفاتورة")
        detail.geometry("500x600")
        center_window(detail, 500, 600)
        t = tk.Text(detail, font=("Courier New", 11),
                    padx=15, pady=15)
        t.pack(fill="both", expand=True)
        t.insert("1.0", text)
        t.configure(state="disabled")

        tk.Button(detail, text="إغلاق",
                  command=detail.destroy,
                  bg="#666", fg="white",
                  font=("Arial", 10, "bold")).pack(pady=8)

    def delete_invoice():
        selected = tree.selection()
        if not selected:
            messagebox.showwarning("تنبيه", "اختر فاتورة أولًا.", parent=win)
            return
        sale_id = tree.item(selected[0], "values")[0]
        if not messagebox.askyesno(
            "تأكيد",
            "حذف الفاتورة سيعيد الكميات إلى المخزون.\nهل تريد المتابعة؟",
            parent=win
        ):
            return
        try:
            conn.execute("BEGIN")
            cur.execute("SELECT * FROM sale_items WHERE sale_id=?", (sale_id,))
            items = cur.fetchall()
            for item in items:
                cur.execute("""
                    UPDATE products SET quantity=quantity+?
                    WHERE id=?
                """, (item["quantity"], item["product_id"]))
            cur.execute("DELETE FROM sale_items WHERE sale_id=?", (sale_id,))
            cur.execute("DELETE FROM sales WHERE id=?", (sale_id,))
            conn.commit()
            load_sales("today")
            refresh_products(search_var.get())
            messagebox.showinfo("نجاح", "تم حذف الفاتورة وإرجاع الكميات.",
                                parent=win)
        except Exception as e:
            conn.rollback()
            messagebox.showerror("خطأ", str(e), parent=win)

    tk.Button(buttons, text="عرض الفاتورة",
              command=show_invoice, bg="#2e8b57", fg="white",
              font=("Arial", 10, "bold")).pack(side="left", padx=5)
    tk.Button(buttons, text="حذف الفاتورة",
              command=delete_invoice, bg="#d9534f", fg="white",
              font=("Arial", 10, "bold")).pack(side="left", padx=5)

    load_sales("today")


# ---------------------------------------------------------
# SETTINGS
# ---------------------------------------------------------
def open_settings():
    win = tk.Toplevel(root)
    win.title("إعدادات المحل")
    win.geometry("500x400")
    center_window(win, 500, 400)
    win.configure(bg="#f2f4f7")

    tk.Label(win, text="إعدادات المحل",
             bg="#1261a0", fg="white",
             font=("Arial", 18, "bold")).pack(fill="x", ipady=12)

    form = tk.Frame(win, bg="#f2f4f7")
    form.pack(fill="both", expand=True, padx=25, pady=20)

    shop_v = tk.StringVar(value=get_setting("shop_name", "نظام إدارة المحل"))
    owner_v = tk.StringVar(value=get_setting("owner_name", "وائل شاكر"))
    phone_v = tk.StringVar(value=get_setting("shop_phone", ""))
    printer_v = tk.StringVar(value=get_setting("printer_name", ""))

    fields = [
        ("اسم المحل:", shop_v),
        ("اسم المالك:", owner_v),
        ("رقم الهاتف:", phone_v),
        ("اسم الطابعة Windows:", printer_v),
    ]

    for i, (label, var) in enumerate(fields):
        tk.Label(form, text=label, bg="#f2f4f7",
                 font=("Arial", 10, "bold")).grid(
                     row=i, column=1, padx=5, pady=10, sticky="e")
        tk.Entry(form, textvariable=var,
                 font=("Arial", 11), justify="right",
                 width=30).grid(row=i, column=0, padx=5, pady=10)

    tk.Label(form,
             text="اترك اسم الطابعة فارغًا لاستخدام طباعة Windows العادية.\n"
                  "للطباعة الخام ESC/POS على Windows يمكن تثبيت pywin32.",
             bg="#f2f4f7", fg="#555",
             font=("Arial", 9), justify="right").grid(
                 row=4, column=0, columnspan=2, pady=15)

    def save():
        set_setting("shop_name", shop_v.get().strip() or "نظام إدارة المحل")
        set_setting("owner_name", owner_v.get().strip() or "وائل شاكر")
        set_setting("shop_phone", phone_v.get().strip())
        set_setting("printer_name", printer_v.get().strip())
        messagebox.showinfo("نجاح", "تم حفظ الإعدادات.", parent=win)
        win.destroy()

    tk.Button(win, text="حفظ الإعدادات",
              command=save, bg="#2e8b57", fg="white",
              font=("Arial", 11, "bold"), width=18).pack(pady=10)


# ---------------------------------------------------------
# BACKUP / RESTORE
# ---------------------------------------------------------
def backup_database():
    conn.commit()
    filename = filedialog.asksaveasfilename(
        parent=root,
        title="حفظ نسخة احتياطية",
        initialfile=f"store_backup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.db",
        defaultextension=".db",
        filetypes=[("SQLite Database", "*.db")]
    )
    if not filename:
        return
    try:
        shutil.copy2(DB_FILE, filename)
        messagebox.showinfo("نجاح", "تم إنشاء النسخة الاحتياطية بنجاح.")
    except Exception as e:
        messagebox.showerror("خطأ", str(e))


def restore_database():
    filename = filedialog.askopenfilename(
        parent=root,
        title="اختيار نسخة احتياطية",
        filetypes=[("SQLite Database", "*.db"), ("All files", "*.*")]
    )
    if not filename:
        return

    if not messagebox.askyesno(
        "تأكيد",
        "استعادة النسخة ستستبدل قاعدة البيانات الحالية.\n"
        "يفضل إنشاء نسخة احتياطية أولًا.\n\nهل تريد المتابعة؟"
    ):
        return

    try:
        conn.commit()
        conn.close()
        shutil.copy2(filename, DB_FILE)
        messagebox.showinfo(
            "تمت الاستعادة",
            "تمت استعادة قاعدة البيانات.\n"
            "سيتم إغلاق البرنامج، ثم يمكنك تشغيله مرة أخرى."
        )
        root.destroy()
    except Exception as e:
        messagebox.showerror("خطأ", str(e))
        # Try to reconnect if possible.
        try:
            globals()["conn"] = sqlite3.connect(DB_FILE)
            conn.row_factory = sqlite3.Row
            globals()["cur"] = conn.cursor()
        except Exception:
            pass


# ---------------------------------------------------------
# MAIN BUTTONS
# ---------------------------------------------------------
bottom_main = tk.Frame(root, bg="#eef2f5")
bottom_main.pack(fill="x", padx=15, pady=12)

buttons = [
    ("نقطة البيع", open_pos, "#18a6b8"),
    ("التقارير والأرباح", open_reports, "#7655a8"),
    ("المخزون", open_inventory, "#2e8b57"),
    ("الإعدادات", open_settings, "#e69b2f"),
    ("نسخة احتياطية", backup_database, "#2878c8"),
    ("استعادة", restore_database, "#d9534f"),
]

for text, command, bg in buttons:
    tk.Button(bottom_main, text=text, command=command,
              bg=bg, fg="white",
              font=("Arial", 11, "bold"),
              width=16, height=2).pack(side="right", padx=5)


# ---------------------------------------------------------
# KEYBOARD SHORTCUTS
# ---------------------------------------------------------
def focus_search(event=None):
    search_entry.focus_set()
    search_entry.selection_range(0, "end")


root.bind("<F2>", lambda e: open_pos())
root.bind("<F3>", focus_search)
root.bind("<F4>", lambda e: open_inventory())
root.bind("<F5>", lambda e: open_reports())


# ---------------------------------------------------------
# START
# ---------------------------------------------------------
refresh_products()
barcode_entry.focus_set()


def on_close():
    try:
        conn.commit()
        conn.close()
    except Exception:
        pass
    root.destroy()


root.protocol("WM_DELETE_WINDOW", on_close)
root.mainloop()
