class InvoiceCalculatorApp(App):

    def build(self):

        self.title = APP_NAME

        manager = ScreenManager()

        manager.add_widget(
            HomeScreen(name="home")
        )

        manager.add_widget(
            CalculatorScreen(
                name="calculator"
            )
        )

        if platform == "android":

            try:
                from android import activity

                home = manager.get_screen(
                    "home"
                )

                activity.bind(
                    on_activity_result=
                    home.android_activity_result
                )

            except Exception:
                pass

        return manager

    def on_stop(self):

        if platform == "android":

            try:
                from android import activity

                home = (
                    self.root.get_screen(
                        "home"
                    )
                )

                activity.unbind(
                    on_activity_result=
                    home.android_activity_result
                )

            except Exception:
                pass


if __name__ == "__main__":

    InvoiceCalculatorApp().run()
