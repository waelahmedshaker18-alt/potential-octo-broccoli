# ============================================================
# الأرقام
# ============================================================

def normalize_number(value):
    if value is None:
        return ""

    value = str(value)

    arabic = "٠١٢٣٤٥٦٧٨٩"
    english = "0123456789"

    for a, e in zip(arabic, english):
        value = value.replace(a, e)

    persian = "۰۱۲۳۴۵۶۷۸۹"

    for a, e in zip(persian, english):
        value = value.replace(a, e)

    value = value.replace("،", ".")
    value = value.replace(",", ".")

    return value


def number_value(value):
    try:
        return float(normalize_number(value))
    except Exception:
        return 0.0


