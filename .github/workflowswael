    # ========================================================
    # أدوات Android
    # ========================================================

    def get_android_activity(self):

        try:
            from jnius import autoclass

            PythonActivity = autoclass(
                "org.kivy.android.PythonActivity"
            )

            return PythonActivity.mActivity

        except Exception:
            return None

    def get_intent_classes(self):

        from jnius import autoclass

        Intent = autoclass(
            "android.content.Intent"
        )

        return Intent

    # ========================================================
    # الكاميرا
    # ========================================================

    def take_photo(self):

        if platform != "android":
            self.show_message(
                "الكاميرا",
                "هذه الخاصية تعمل على Android."
            )
            return

        if self.waiting_for_camera:
            return

        try:

            activity = self.get_android_activity()

            if activity is None:
                self.show_message(
                    "الكاميرا",
                    "تعذر الوصول إلى Activity الخاصة بـ Android."
                )
                return

            Intent = self.get_intent_classes()

            intent = Intent(
                "android.media.action.IMAGE_CAPTURE"
            )

            package_manager = (
                activity.getPackageManager()
            )

            resolver = intent.resolveActivity(
                package_manager
            )

            if resolver is None:
                self.show_message(
                    "الكاميرا",
                    "لا يوجد تطبيق كاميرا متاح على الهاتف."
                )
                return

            self.waiting_for_camera = True

            activity.startActivityForResult(
                intent,
                7101
            )

        except Exception as e:

            self.waiting_for_camera = False

            self.show_message(
                "الكاميرا",
                "تعذر تشغيل تطبيق الكاميرا.\n\n"
                + str(e)
            )

    # ========================================================
    # معرض الصور
    # ========================================================

    def choose_image(self):

        if platform != "android":
            self.show_message(
                "الصور",
                "هذه الخاصية تعمل على Android."
            )
            return

        if self.waiting_for_gallery:
            return

        try:

            activity = self.get_android_activity()

            if activity is None:
                self.show_message(
                    "الصور",
                    "تعذر الوصول إلى Android."
                )
                return

            Intent = self.get_intent_classes()

            intent = Intent(
                "android.intent.action.OPEN_DOCUMENT"
            )

            intent.addCategory(
                "android.intent.category.OPENABLE"
            )

            intent.setType("image/*")

            package_manager = (
                activity.getPackageManager()
            )

            resolver = intent.resolveActivity(
                package_manager
            )

            if resolver is None:

                intent = Intent(
                    "android.intent.action.GET_CONTENT"
                )

                intent.addCategory(
                    "android.intent.category.OPENABLE"
                )

                intent.setType("image/*")

            self.waiting_for_gallery = True

            activity.startActivityForResult(
                intent,
                7102
            )

        except Exception as e:

            self.waiting_for_gallery = False

            self.show_message(
                "الصور",
                "تعذر فتح معرض الصور.\n\n"
                + str(e)
            )

    # ========================================================
    # استقبال نتيجة Android
    # ========================================================

    def android_activity_result(
        self,
        request_code,
        result_code,
        intent
    ):

        try:

            if result_code != -1:
                self.waiting_for_camera = False
                self.waiting_for_gallery = False
                return

            if request_code == 7101:

                Clock.schedule_once(
                    lambda dt:
                    self.process_camera_result(intent),
                    0.1
                )

                return

            if request_code == 7102:

                Clock.schedule_once(
                    lambda dt:
                    self.process_gallery_result(intent),
                    0.1
                )

        except Exception as e:

            self.waiting_for_camera = False
            self.waiting_for_gallery = False

            self.show_message(
                "Android",
                "حدث خطأ في استلام الصورة.\n\n"
                + str(e)
            )

    # ========================================================
    # معالجة صورة الكاميرا
    # ========================================================

    def process_camera_result(self, intent):

        self.waiting_for_camera = False

        try:

            if intent is None:
                raise Exception(
                    "الكاميرا لم ترجع صورة."
                )

            extras = intent.getExtras()

            if extras is None:
                raise Exception(
                    "لم ترجع الكاميرا بيانات الصورة."
                )

            bitmap = extras.get("data")

            if bitmap is None:
                raise Exception(
                    "لم ترجع الكاميرا الصورة."
                )

            from jnius import autoclass

            folder = (
                App.get_running_app()
                .user_data_dir
            )

            os.makedirs(
                folder,
                exist_ok=True
            )

            output_path = os.path.join(
                folder,
                "invoice_camera.jpg"
            )

            FileOutputStream = autoclass(
                "java.io.FileOutputStream"
            )

            CompressFormat = autoclass(
                "android.graphics.Bitmap$CompressFormat"
            )

            output_stream = FileOutputStream(
                output_path
            )

            bitmap.compress(
                CompressFormat.JPEG,
                95,
                output_stream
            )

            output_stream.flush()
            output_stream.close()

            try:
                bitmap.recycle()
            except Exception:
                pass

            if not os.path.exists(
                output_path
            ):
                raise Exception(
                    "تم التصوير ولكن لم يتم حفظ الصورة."
                )

            self.set_image(
                output_path
            )

        except Exception as e:

            self.show_message(
                "الكاميرا",
                "تعذر استلام صورة الكاميرا.\n\n"
                + str(e)
            )

    # ========================================================
    # معالجة صورة المعرض
    # ========================================================

    def process_gallery_result(self, intent):

        self.waiting_for_gallery = False

        try:

            if intent is None:
                raise Exception(
                    "لم يتم اختيار صورة."
                )

            uri = intent.getData()

            if uri is None:
                raise Exception(
                    "لم يتم اختيار صورة."
                )

            self.copy_uri_to_file(
                uri
            )

        except Exception as e:

            self.show_message(
                "الصور",
                "تعذر قراءة الصورة.\n\n"
                + str(e)
            )

    # ========================================================
    # نسخ الصورة المختارة إلى مجلد البرنامج
    # ========================================================

    def copy_uri_to_file(self, uri):

        try:

            from jnius import autoclass

            activity = self.get_android_activity()

            if activity is None:
                raise Exception(
                    "تعذر الوصول إلى Android."
                )

            resolver = (
                activity.getContentResolver()
            )

            stream = resolver.openInputStream(
                uri
            )

            if stream is None:
                raise Exception(
                    "تعذر فتح الصورة."
                )

            BitmapFactory = autoclass(
                "android.graphics.BitmapFactory"
            )

            bitmap = BitmapFactory.decodeStream(
                stream
            )

            stream.close()

            if bitmap is None:
                raise Exception(
                    "تعذر قراءة صورة الفاتورة."
                )

            folder = (
                App.get_running_app()
                .user_data_dir
            )

            os.makedirs(
                folder,
                exist_ok=True
            )

            output_path = os.path.join(
                folder,
                "invoice_selected.jpg"
            )

            FileOutputStream = autoclass(
                "java.io.FileOutputStream"
            )

            CompressFormat = autoclass(
                "android.graphics.Bitmap$CompressFormat"
            )

            output_stream = FileOutputStream(
                output_path
            )

            bitmap.compress(
                CompressFormat.JPEG,
                95,
                output_stream
            )

            output_stream.flush()
            output_stream.close()

            try:
                bitmap.recycle()
            except Exception:
                pass

            if not os.path.exists(
                output_path
            ):
                raise Exception(
                    "تعذر حفظ الصورة."
                )

            self.set_image(
                output_path
            )

        except Exception as e:

            self.show_message(
                "الصور",
                "تعذر تجهيز الصورة للبرنامج.\n\n"
                + str(e)
            )

    # ========================================================
    # الصورة
    # ========================================================

    def set_image(self, path):

        try:

            if not path:
                return

            if not os.path.exists(path):
                return

            self.image_path = path

            self.invoice_image.source = path
            self.invoice_image.reload()

        except Exception as e:

            self.show_message(
                "الصورة",
                "تعذر عرض الصورة.\n\n"
                + str(e)
            )

    def clear_image(self):

        self.image_path = ""

        self.invoice_image.source = ""

        self.invoice_image.reload()

    # ========================================================
    # الحاسبة
    # ========================================================

    def open_calculator(self):

        self.manager.current = "calculator"

    # ========================================================
    # الرسائل
    # ========================================================

    def show_message(
        self,
        title,
        message
    ):

        label = Label(
            text=ar(message),
            font_name=ARABIC_FONT,
            font_size=dp(15),
            halign="center",
            valign="middle",
            color=(0.95, 0.95, 0.95, 1)
        )

        label.bind(
            size=lambda o, v:
            setattr(o, "text_size", v)
        )

        popup = Popup(
            title=ar(title),
            title_font=ARABIC_FONT,
            content=label,
            size_hint=(0.90, 0.52),
            auto_dismiss=True
        )

        popup.open()


