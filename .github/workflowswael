try:
    import arabic_reshaper
    from bidi.algorithm import get_display
    ARABIC_SUPPORT = True
except Exception:
    ARABIC_SUPPORT = False


def ar(text):
    if text is None:
        return ""
    text = str(text)

    if not ARABIC_SUPPORT:
        return text

    try:
        return get_display(arabic_reshaper.reshape(text))
    except Exception:
        return text


