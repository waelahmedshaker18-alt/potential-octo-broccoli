                1,
                1,
                1,
                1
            )
        )

    # ========================================================
    # البنود
    # ========================================================

    def reset_rows(self):

        self.rows_container.clear_widgets()

        self.rows = []

        for _ in range(5):
            self.add_row()

        self.calculate_total()

    def add_row(self):

        number = len(self.rows) + 1

        row = BoxLayout(
            orientation="horizontal",
            spacing=dp(4),
            size_hint_y=None,
            height=dp(48)
        )

        item = TextInput(
            text="",
            hint_text=str(number),
            font_name=ARABIC_FONT,
            font_size=dp(13),
            multiline=False,
            halign="center",
            background_normal="",
            background_color=(
                0.10,
                0.10,
                0.10,
                1
            ),
            foreground_color=(
                1,
                1,
                1,
                1
            ),
            hint_text_color=(
                0.45,
                0.45,
                0.45,
                1
            )
        )

        price = TextInput(
            text="",
            hint_text="0",
            font_name=ARABIC_FONT,
            font_size=dp(14),
            multiline=False,
            input_filter="float",
            halign="center",
            background_normal="",
            background_color=(
                0.10,
                0.10,
                0.10,
                1
            ),
            foreground_color=(
                1,
                1,
                1,
                1
            ),
            hint_text_color=(
                0.45,
                0.45,
                0.45,
                1
            )
        )

        quantity = TextInput(
            text="",
            hint_text="1",
            font_name=ARABIC_FONT,
            font_size=dp(14),
            multiline=False,
            input_filter="float",
            halign="center",
            background_normal="",
            background_color=(
                0.10,
                0.10,
                0.10,
                1
            ),
            foreground_color=(
                1,
                1,
                1,
                1
            ),
            hint_text_color=(
                0.45,
                0.45,
                0.45,
                1
            )
        )

        result = Label(
            text="0",
            font_name=ARABIC_FONT,
            font_size=dp(14),
            bold=True,
            color=(
                0.95,
                0.72,
                0.15,
                1
            ),
            halign="center",
            valign="middle"
        )

        result.bind(
            size=lambda o, v:
            setattr(o, "text_size", v)
        )

        row.add_widget(item)
        row.add_widget(price)
        row.add_widget(quantity)
        row.add_widget(result)

        self.rows_container.add_widget(row)

        data = {
            "item": item,
            "price": price,
            "quantity": quantity,
            "result": result
        }

        self.rows.append(data)

        price.bind(
            text=lambda *_:
            self.update_row(
                price,
                quantity,
                result
            )
        )

        quantity.bind(
            text=lambda *_:
            self.update_row(
                price,
                quantity,
                result
            )
        )

    def update_row(
        self,
        price,
        quantity,
        result
    ):

        p = number_value(
            price.text
        )

        q = number_value(
            quantity.text
        )

        value = p * q

        if value == int(value):
            result.text = str(
                int(value)
            )
        else:
            result.text = "{:.2f}".format(
                value
            )

        self.calculate_total()

    # ========================================================
    # الحساب
    # ========================================================

    def calculate_total(self):

        subtotal = 0.0

        for row in self.rows:

            p = number_value(
                row["price"].text
            )

            q = number_value(
                row["quantity"].text
            )

            subtotal += p * q

        discount = number_value(
            self.discount_input.text
        )

        tax_percent = number_value(
            self.tax_input.text
        )

        paid = number_value(
            self.paid_input.text
        )

        if discount < 0:
            discount = 0.0

        if discount > subtotal:
            discount = subtotal

        after_discount = (
            subtotal - discount
        )

        tax = (
            after_discount *
            (tax_percent / 100.0)
        )

        total = (
            after_discount + tax
        )

        remaining = (
            total - paid
        )

        self.subtotal_value.text = ar(
            self._money(subtotal)
            + " جنيه"
        )

        self.total_label.text = ar(
            "الإجمالي: "
            + self._money(total)
            + " جنيه"
        )

        if remaining < 0:

            self.remaining_label.text = ar(
                "المرتجع: "
                + self._money(
                    abs(remaining)
                )
                + " جنيه"
            )

        else:

            self.remaining_label.text = ar(
                "الباقي: "
                + self._money(remaining)
                + " جنيه"
            )

    def _money(self, value):

        if abs(
            value - int(value)
        ) < 0.000001:

            return str(
                int(value)
            )

        return "{:.2f}".format(value)


