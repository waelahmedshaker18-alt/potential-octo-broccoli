            bold=True,
            color=(0.90, 0.90, 0.90, 1),
            background_normal="",
            background_color=(
                0.18,
                0.18,
                0.18,
                1
            )
        )

        back_button.bind(
            on_release=lambda *_:
            setattr(
                self.manager,
                "current",
